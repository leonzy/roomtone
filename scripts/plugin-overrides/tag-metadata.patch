+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {browserHarness} from './browser-harness.mjs';
+
+test('a 70518-song library loads and renders only one page and one directory level',async t=>{
+ const h=browserHarness();t.after(h.close);await h.w.loadSongs();
+ const w=h.w;
+ assert.equal(w.S._total,70518);assert.equal(w.S._allSongs.length,100);
+ assert.equal(w.document.querySelectorAll('#songList .song-card').length,100);
+ assert.ok(w.document.querySelectorAll('#treeContainer .b-tn').length<=101);
+ assert.equal(h.calls.filter(c=>c.url.pathname.endsWith('/browse')).length,1);
+ assert.ok(h.calls.every(c=>!c.url.pathname.endsWith('/songs')));
+ assert.match(w.document.getElementById('browsePager').textContent,/706/);
+ w.S._page=1;await w.loadSongs();assert.equal(w.S.songs[0].id,101);assert.equal(w.S.songs.length,100);
+ w.S._curPath='album-4';w.S._page=0;await w.loadSongs();
+ assert.equal(w.S._allSongs.length,35);assert.equal(w.S._total,35);
+ assert.equal(h.calls.filter(c=>c.url.pathname.endsWith('/browse')).at(-1).url.searchParams.get('path'),'album-4');
+});
+test('a late response cannot replace a newer page',async t=>{
+ let release;let first=true;
+ const h=browserHarness(async url=>{
+  if(url.pathname.endsWith('/browse')&&first){first=false;return new Promise(resolve=>{release=()=>resolve({ok:true,json:async()=>({songs:[{id:1,type:'local'}],total:70518,folders:[]})})})}
+ });t.after(h.close);
+ const old=h.w.loadSongs();await new Promise(setImmediate);
+ h.w.S._page=1;await h.w.loadSongs();release();await old;
+ assert.equal(h.w.S.songs[0].id,101);
+});
+test('select-all selects the current page and selected metadata survives page changes',async t=>{
+ const h=browserHarness();t.after(h.close);const w=h.w;await w.loadSongs();w.selAll();assert.equal(w.S.sel.size,100);
+ w.S._page=1;await w.loadSongs();assert.equal(w.S.songs.length,100);assert.equal(w.findSong(1).id,1);
+ w.tgl(101);assert.equal(w.S.sel.size,101);
+ for(let page=2;page<8;page++){w.S._page=page;await w.loadSongs();assert.equal(w.S.songs.length,100)}
+ assert.ok(w.S._songCache.size<=500);assert.equal(w.findSong(1).id,1);
+ w.selNone();assert.equal(w.S.sel.size,0);
+});
+test('failed requests preserve the previous page instead of displaying partial data',async t=>{
+ let fail=false;const h=browserHarness(url=>{if(fail&&url.pathname.endsWith('/browse'))return {ok:false,status:500}});t.after(h.close);
+ await h.w.loadSongs();const previous=h.w.S.songs;fail=true;h.w.S._page=1;await h.w.loadSongs();assert.equal(h.w.S.songs,previous);
+ assert.match(h.w.document.getElementById('barInfo').textContent,/加载失败/);
+});
+test('review and organize views also keep their song DOM bounded',async t=>{
+ const h=browserHarness();t.after(h.close);const w=h.w;
+ w.S._tab='failed';w.S._triage='red';await w.renderReview();assert.equal(w.S._reviewSongs.length,1);
+ assert.equal(w.document.getElementById('tr-cnt').textContent,'1');
+ w.S._tab='organize';await w.loadOrgSongs();assert.ok(w.document.querySelectorAll('#orgList .song-card').length<=100);
+});
diff --git a/tests/search-matching.test.mjs b/tests/search-matching.test.mjs
new file mode 100644
index 0000000..e5fa3e3
--- /dev/null
+++ b/tests/search-matching.test.mjs
@@ -0,0 +1,86 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import test from 'node:test';
+import ts from 'typescript';
+
+function load(name) {
+  const context = vm.createContext({ exports: {}, Error, SyntaxError, Number, String });
+  vm.runInContext(ts.transpileModule(readFileSync(new URL(`../src/${name}.ts`, import.meta.url), 'utf8'),
+    { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 } }).outputText, context);
+  return context.exports;
+}
+const { extractCandidates } = load('candidates');
+const { scoreMatch } = load('scoring');
+const { searchQQ } = load('qq-search');
+const { formatSourceDiagnostic } = load('scrape-diagnostics');
+const candidates = (path, tags) => JSON.parse(JSON.stringify(extractCandidates(path, tags)));
+
+test('reported filename splits track number, spaced underscore, artist and title', () => {
+  assert.deepEqual(candidates('/music/07.Arnica Montana _ Sea, Sand And Sun.wav'), [
+    { artist: 'Arnica Montana', title: 'Sea, Sand And Sun' },
+    { artist: 'Sea, Sand And Sun', title: 'Arnica Montana' },
+  ]);
+});
+test('download promotion and track numbers are removed without damaging artist underscores', () => {
+  assert.deepEqual(candidates('08 Candy_Wind - 青空[抖音：小G音乐][FLAC].flac')[0], { artist: 'Candy_Wind', title: '青空' });
+  assert.deepEqual(candidates('221小伙伴 - 遥远的你 (正式版) 抖音：小G音乐.mp3')[0], { artist: '221小伙伴', title: '遥远的你 (正式版)' });
+});
+test('versions, meaningful numbers and hyphens are preserved', () => {
+  assert.equal(candidates('AC-DC - Thunderstruck (Live).flac')[0].artist, 'AC-DC');
+  assert.equal(candidates('Artist — Song (Remix).mp3')[0].title, 'Song (Remix)');
+  assert.equal(candidates('21 Guns.mp3')[0].title, '21 Guns');
+  assert.equal(candidates('1984.mp3', { artist: 'Artist', title: '1984' })[0].title, '1984');
+});
+test('valid tags take priority, garbage tags fall back to the filename, title-only tags work', () => {
+  assert.deepEqual(candidates('wrong-file.mp3', { artist: 'Queen', title: 'Bohemian Rhapsody' }), [{ artist: 'Queen', title: 'Bohemian Rhapsody' }]);
+  assert.equal(candidates('Sea And Sun.wav', { artist: 'Unknown', title: 'Track 01' })[0].title, 'Sea And Sun');
+  assert.equal(candidates('', { title: 'Sea And Sun' })[0].title, 'Sea And Sun');
+  assert.equal(candidates('Track 01.wav')[0].title, '');
+});
+test('missing artist no longer caps an exact title match below the configured threshold', () => {
+  assert.equal(scoreMatch({ artist: '', title: '晴天' }, { artist: '周杰伦', title: '晴天', source: 'qqmusic' }), 0.95);
+  assert.equal(scoreMatch({ artist: '', title: '' }, { artist: '周杰伦', title: '晴天', source: 'qqmusic' }), 0);
+});
+test('artist mismatch and duration mismatch still reduce the score', () => {
+  const result = { artist: 'Correct artist', title: 'Exact title', source: 'qqmusic', duration: 300 };
+  const exact = scoreMatch({ artist: result.artist, title: result.title, duration: 300 }, result);
+  assert.ok(scoreMatch({ artist: 'Other person', title: result.title, duration: 300 }, result) < exact);
+  assert.ok(scoreMatch({ artist: result.artist, title: result.title, duration: 100 }, result) < exact);
+});
+
+test('known legacy QQ URL uses the verified modern search protocol and response fields', async () => {
+  const result = await searchQQ('周杰伦 晴天', 'https://c.y.qq.com/soso/fcgi-bin/search_for_qq_cp', async (url, init) => {
+    assert.equal(url, 'https://u.y.qq.com/cgi-bin/musicu.fcg');
+    assert.equal(init.method, 'POST');
+    const body = JSON.parse(init.body);
+    assert.equal(body.search.param.query, '周杰伦 晴天');
+    return { json: async () => ({ code: 0, search: { code: 0, data: { body: { song: { list: [
+      { name: '晴天', singer: [{ name: '周杰伦' }], album: { name: '叶惠美', mid: 'album-mid' }, mid: 'song-mid', interval: 269 },
+    ] } } } } }) };
+  });
+  assert.equal(result[0].title, '晴天'); assert.equal(result[0].artist, '周杰伦');
+  assert.equal(result[0].album, '叶惠美'); assert.equal(result[0].duration, 269); assert.equal(result[0].sourceId, 'song-mid');
+});
+test('custom QQ URLs retain authentication parameters and support the legacy result structure', async () => {
+  const result = await searchQQ('test song', 'https://api.example/search?key=example&w=old', async (url, init) => {
+    assert.match(url, /key=example/); assert.match(url, /w=test%20song/); assert.doesNotMatch(url, /w=old|\?[^?]*\?/);
+    assert.equal(init.method, undefined);
+    return { json: async () => ({ code: 0, data: { song: { list: [{ singer: [{ name: 'Artist' }], songname: 'Song', albumname: 'Album' }] } } }) };
+  });
+  assert.equal(result[0].album, 'Album');
+});
+test('QQ HTTP-success business errors are reported as errors, not empty search results', async () => {
+  await assert.rejects(searchQQ('song', 'https://api.example/search', async () => ({ json: async () => ({ code: 500001 }) })), /业务错误码 500001/);
+  await assert.rejects(searchQQ('song', 'https://u.y.qq.com/cgi-bin/musicu.fcg', async () => ({ json: async () => ({ code: 0, search: { code: 2000 } }) })), /搜索业务错误码 2000/);
+});
+test('QQ empty lists, invalid JSON and incompatible schemas remain distinguishable', async () => {
+  assert.equal((await searchQQ('song', 'https://api.example/search', async () => ({ json: async () => ({ data: { song: { list: [] } } }) }))).length, 0);
+  await assert.rejects(searchQQ('song', 'https://api.example/search', async () => ({ json: async () => ({ data: {} }) })), /响应格式不兼容/);
+  await assert.rejects(searchQQ('song', 'https://api.example/search', async () => ({ json: async () => { throw new SyntaxError('HTML'); } })), /不是有效 JSON/);
+});
+test('source-specific diagnostics distinguish failures, no results and low scores', () => {
+  assert.match(formatSourceDiagnostic('qqmusic', { count: 0, score: 0, error: '业务错误码 500001' }, 0.7), /QQ音乐：接口失败.*500001/);
+  assert.equal(formatSourceDiagnostic('qqmusic', { count: 0, score: 0 }, 0.7), 'QQ音乐：搜索成功，但没有候选歌曲');
+  assert.equal(formatSourceDiagnostic('migu', { count: 3, score: 0.26 }, 0.7), '咪咕：候选最高得分 0.26，低于阈值 0.70');
+});
diff --git a/tests/source-diagnostics-engine.test.mjs b/tests/source-diagnostics-engine.test.mjs
new file mode 100644
index 0000000..1f9cfd5
--- /dev/null
+++ b/tests/source-diagnostics-engine.test.mjs
@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import vm from 'node:vm';
+import test from 'node:test';
+import ts from 'typescript';
+
+function module(name, dependencies = {}, globals = {}) {
+  const context = vm.createContext({ exports: {}, Error, ...globals, require: name => dependencies[name] || {} });
+  vm.runInContext(ts.transpileModule(readFileSync(new URL(`../src/${name}.ts`, import.meta.url), 'utf8'),
+    { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 } }).outputText, context);
+  return context.exports;
+}
+
+async function run(qq, allowLowScore = false) {
+  const queries = [], reasons = [];
+  const scraper = module('scraper', {
+    './sources': { ...module('candidates'), searchQQMusic: async kw => { queries.push(kw); return qq(kw); },
+      searchMiGu: async () => [{ artist: 'Different artist', title: 'Different song', source: 'migu' }] },
+    './scoring': { scoreMatch: () => 0.26 },
+    './t2s': { toSimplified: s => s },
+    './cache': { cacheSet: async () => {} },
+    './ratelimit': { rateLimitWait: async () => {} },
+    './circuit': { circuitIsOpen: () => false, circuitSuccess() {}, circuitFailure() {} },
+    './scrape-diagnostics': module('scrape-diagnostics'),
+  }, { songloft: { songs: { getById: async () => ({ type: 'local', file_path: '07.Arnica Montana _ Sea, Sand And Sun.wav' }) }, log: { info() {}, warn() {} } } });
+  const result = await scraper.doScrape(42, { enable_qqmusic: true, qqmusic_api_url: 'https://example.test', enable_migu: true, score_threshold: 0.7 },
+    { skipCache: true, allowLowScore, onDiagnostic: r => reasons.push(r) });
+  if (!allowLowScore) assert.equal(result, null);
+  return { queries, reasons, result };
+}
+
+test('engine reports QQ failure and Migu score on separate lines across reversed queries', async () => {
+  const { queries, reasons } = await run(() => { throw new Error('QQ音乐业务错误码 500001'); });
+  assert.equal(queries[0], 'Arnica Montana Sea, Sand And Sun');
+  assert.equal(queries.length, 2);
+  assert.equal(reasons.filter(s => s.startsWith('QQ音乐：')).length, 1);
+  assert.match(reasons.join('\n'), /QQ音乐：接口失败.*500001/);
+  assert.match(reasons.join('\n'), /咪咕：候选最高得分 0.26，低于阈值 0.70/);
+  assert.match(reasons.join('\n'), /最佳候选来自咪咕/);
+});
+
+test('manual preview returns low-score candidates while automatic scraping still rejects them', async () => {
+  const { result } = await run(() => [], true);
+  assert.equal(result.score, 0.26);
+  assert.equal(result.source, 'migu');
+  assert.equal((await run(() => [])).result, null);
+});
+
+test('QQ business error 2001 retries once with title while preserving diagnostics', async () => {
+  const { queries, reasons } = await run(kw => {
+    if (kw.includes('Arnica Montana ') || kw.startsWith('Sea, Sand And Sun ')) throw new Error('QQ音乐搜索业务错误码 2001');
+    return [];
+  });
+  assert.deepEqual(queries.slice(0, 2), ['Arnica Montana Sea, Sand And Sun', 'Sea, Sand And Sun']);
+  assert.ok(reasons.some(r => r.includes('已改用歌名重试')));
+});
+
+test('engine distinguishes an empty successful QQ search from low-scoring Migu candidates', async () => {
+  const { reasons } = await run(() => []);
+  assert.ok(reasons.includes('QQ音乐：搜索成功，但没有候选歌曲'));
+  assert.ok(reasons.some(r => r.startsWith('咪咕：候选最高得分')));
+  assert.ok(!reasons.some(r => r.includes('接口失败')));
+});
